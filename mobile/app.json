{
  "expo": {
    "name": "6th Sense AI",
    "slug": "sixth-sense-ai",
    "scheme": "sixthsense",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fcf9f2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.sixthsense.app",
      "infoPlist": {
        "NSCameraUsageDescription": "6th Sense AI uses the camera to describe your surroundings, read text and detect hazards.",
        "NSMicrophoneUsageDescription": "6th Sense AI listens when you press the voice button so you can ask questions.",
        "NSSpeechRecognitionUsageDescription": "Your spoken questions are converted to text to answer them.",
        "NSLocationWhenInUseUsageDescription": "Location is used for navigation and to share where you are in an emergency.",
        "NSMotionUsageDescription": "Motion sensors are used to detect a possible fall and count steps during navigation.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "ai.sixthsense.app",
      "adaptiveIcon": {
        "backgroundColor": "#191C1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Inter-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Inter-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "MaterialSymbolsOutlined",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/MaterialSymbolsOutlined.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "MaterialSymbolsFilled",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/MaterialSymbolsFilled.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Inter-Regular.ttf",
              "./assets/fonts/Inter-Medium.ttf",
              "./assets/fonts/Inter-SemiBold.ttf",
              "./assets/fonts/Inter-Bold.ttf",
              "./assets/fonts/MaterialSymbolsOutlined.ttf",
              "./assets/fonts/MaterialSymbolsFilled.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fcf9f2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-speech-recognition",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true,
          "enableCoreMLDelegate": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location is used for navigation, remembering where you left things, and sharing where you are in an emergency."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Motion sensors detect a possible fall and count steps during indoor navigation."
        }
      ],
      "react-native-audio-api",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
