# Copy to backend/.env and fill in. Never commit .env.
JWT_SECRET=change-me-to-a-long-random-string
# Cloud reasoning (Google Gemini). Leave empty to use the local Ollama model / detection-only answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Local fallback (text-only): ollama pull qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
MODELS_DIR=D:\6thSenseAI\models
# Optional automatic emergency SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
